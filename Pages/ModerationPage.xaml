<Page x:Class="MovieApp_Adminpanel.Pages.ModerationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Модерация" Background="Transparent">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
			<!-- ВКЛАДКА 1: ОЖИДАЮТ ПРОВЕРКИ -->
			<TabItem Header="Очередь (Pending)">
				<StackPanel Margin="0,10,0,0">
					<DataGrid x:Name="ModerationGrid" AutoGenerateColumns="False" Height="500" 
                              Background="{StaticResource DarkBlack}" RowBackground="{StaticResource DarkBlack}"
                              BorderThickness="0" IsReadOnly="True">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Автор" Binding="{Binding Username}" Width="120"/>
							<DataGridTextColumn Header="ID Фильма" Binding="{Binding MovieTitle}" Width="150"/>
							<DataGridTemplateColumn Header="Текст отзыва" Width="Auto">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding ReviewText}" TextWrapping="Wrap" MaxHeight="60"/>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt}" Width="100"/>
							<DataGridTemplateColumn Header="Действия" Width="Auto">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal">
											<Button Content="Одобрить" Background="Green" Foreground="White" 
                                                    Width="80" Margin="0,0,5,0" Click="Approve_Click"/>
											<Button Content="Отклонить" Background="{StaticResource PrimaryRed}" 
                                                    Foreground="White" Width="80" Click="Reject_Click"/>
										</StackPanel>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
						</DataGrid.Columns>
					</DataGrid>
				</StackPanel>
			</TabItem>

			<!-- ВКЛАДКА 2: ВСЕ ОТЗЫВЫ -->
			<TabItem Header="История всех отзывов" Selector.Selected="AllReviewsTab_Selected">
				<StackPanel Margin="0,10,0,0">
					<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
						<TextBox x:Name="SearchBoxAll" Width="250" Tag="Поиск по тексту..."
						TextChanged="SearchBoxAll_TextChanged"/>
						<TextBlock Text="🔍" VerticalAlignment="Center" Margin="-30,0" Foreground="{StaticResource Gray}"/>
					</StackPanel>

					<DataGrid x:Name="AllReviewsGrid" AutoGenerateColumns="False" Height="460" 
                              Background="{StaticResource DarkBlack}" IsReadOnly="True">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Автор" Binding="{Binding Username}" Width="120"/>
							<DataGridTextColumn Header="Текст" Binding="{Binding ReviewText}" Width="*"/>
							<DataGridTemplateColumn Header="Статус" Width="100">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="Bold"/>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt}" Width="100"/>
						</DataGrid.Columns>
					</DataGrid>
				</StackPanel>
			</TabItem>
		</TabControl>
	</Grid>
</Page>