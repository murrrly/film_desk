<Page x:Class="MovieApp_Adminpanel.Pages.ModerationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Модерация">

	<StackPanel Margin="20">
		<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
			<CheckBox x:Name="OnlyNewCheck" Content="Только новые" Margin="0,0,10,0"/>
			<TextBox x:Name="SearchBox" Width="250" />
			<Button Content="Поиск" Margin="10,0" Width="100" Click="Search_Click"/>
		</StackPanel>

		<DataGrid x:Name="ModerationGrid" AutoGenerateColumns="False" Height="500" >
			<DataGrid.Columns>
				<DataGridTextColumn Header="Автор" Binding="{Binding Username}" Width="150"/>
				<DataGridTextColumn Header="Фильм/Сериал" Binding="{Binding MovieTitle}" Width="200"/>
				<DataGridTextColumn Header="Текст" Binding="{Binding ReviewText}" Width="*"/>
				<DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt}" Width="150"/>
				<DataGridTemplateColumn Header="Действия" Width="200">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal">
								<Button Content="Одобрить" Margin="0,0,5,0" Click="Approve_Click"/>
								<Button Content="Отклонить" Click="Reject_Click"/>
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>
	</StackPanel>
</Page>