<Page x:Class="MovieApp_Adminpanel.Pages.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Аналитика">

	<StackPanel Margin="20">
		<GroupBox Header="Выбор периода" Margin="0,0,0,10">
			<StackPanel Orientation="Horizontal" Margin="10">
				<TextBlock Text="С:" VerticalAlignment="Center"/>
				<DatePicker x:Name="DateFromPicker" Margin="5,0"/>
				<TextBlock Text="По:" VerticalAlignment="Center" Margin="10,0,0,0"/>
				<DatePicker x:Name="DateToPicker" Margin="5,0"/>
				<Button Content="Сформировать отчёт" Margin="10,0" Click="GenerateReport_Click"/>
			</StackPanel>
		</GroupBox>

		<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
			<TextBlock Text="Всего пользователей:" VerticalAlignment="Center"/>
			<TextBlock x:Name="TotalUsersText" Margin="5,0"/>
			<TextBlock Text="Всего отзывов:" Margin="20,0,0,0" VerticalAlignment="Center"/>
			<TextBlock x:Name="TotalReviewsText" Margin="5,0"/>
			<TextBlock Text="Средний рейтинг:" Margin="20,0,0,0" VerticalAlignment="Center"/>
			<TextBlock x:Name="AvgRatingText" Margin="5,0"/>
			<TextBlock Text="Активных пользователей:" Margin="20,0,0,0" VerticalAlignment="Center"/>
			<TextBlock x:Name="ActiveUsersText" Margin="5,0"/>
			<Button Content="Обновить" Margin="20,0,0,0" Click="Refresh_Click"/>
		</StackPanel>

		<TabControl>
			<TabItem Header="Активность пользователей">
				<DataGrid x:Name="UserActivityGrid" AutoGenerateColumns="False" Height="300">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Пользователь" Binding="{Binding Username}" Width="200"/>
						<DataGridTextColumn Header="Регистрации" Binding="{Binding Registrations}" Width="100"/>
						<DataGridTextColumn Header="Активность" Binding="{Binding Activity}" Width="*"/>
					</DataGrid.Columns>
				</DataGrid>
			</TabItem>

			<TabItem Header="Популярные фильмы">
				<DataGrid x:Name="PopularMoviesGrid" AutoGenerateColumns="False" Height="300">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
						<DataGridTextColumn Header="Просмотры" Binding="{Binding Views}" Width="100"/>
						<DataGridTextColumn Header="Добавления в watchlist" Binding="{Binding WatchlistAdds}" Width="100"/>
					</DataGrid.Columns>
				</DataGrid>
			</TabItem>

			<TabItem Header="Ошибки поиска">
				<DataGrid x:Name="SearchErrorsGrid" AutoGenerateColumns="False" Height="300">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Запрос" Binding="{Binding Query}" Width="*"/>
						<DataGridTextColumn Header="Результатов" Binding="{Binding ResultsCount}" Width="100"/>
					</DataGrid.Columns>
				</DataGrid>
			</TabItem>
		</TabControl>
	</StackPanel>
</Page>