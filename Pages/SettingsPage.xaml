<Page x:Class="MovieApp_Adminpanel.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Настройки системы">

	<StackPanel Margin="20">
		<GroupBox Header="Общие параметры" Margin="0,0,0,10">
			<StackPanel Margin="10">
				<StackPanel Orientation="Horizontal" Margin="0,0,0,5">
					<TextBlock Text="Лимит запросов/мин:" Width="200"/>
					<TextBox x:Name="RequestLimitBox" Width="50" Text="100"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal" Margin="0,0,0,5">
					<TextBlock Text="Время жизни кеша (часы):" Width="200"/>
					<TextBox x:Name="CacheTTLBox" Width="50" Text="24"/>
				</StackPanel>
				<CheckBox x:Name="AutoModerationCheck" Content="Включить автоматическую модерацию" Margin="0,5"/>
			</StackPanel>
		</GroupBox>

		<GroupBox Header="Безопасность" Margin="0,0,0,10">
			<StackPanel Margin="10">
				<CheckBox x:Name="Enable2FAAdmin" Content="Включить двухфакторную аутентификацию для админов" Margin="0,5"/>
				<StackPanel Orientation="Horizontal" Margin="0,0,0,5">
					<TextBlock Text="Политика паролей (мин.длина):" Width="200"/>
					<TextBox x:Name="PasswordPolicyBox" Width="50" Text="8"/>
				</StackPanel>
			</StackPanel>
		</GroupBox>

		<Button Content="Сохранить" Width="150" HorizontalAlignment="Left" Click="SaveSettings_Click"/>
	</StackPanel>
</Page>