<Page x:Class="MovieApp_Adminpanel.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Настройки">

	<ScrollViewer>
		<StackPanel Margin="20" Width="400">

			<TextBlock Text="Системные настройки"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0 0 0 20"/>

			<!-- TMDB -->
			<TextBlock Text="TMDB API Key"/>
			<TextBox x:Name="TmdbKeyBox"
                     Width="300"
                     Margin="0 0 0 10"/>

			<!-- Email для уведомлений -->
			<TextBlock Text="Email администратора"/>
			<TextBox x:Name="EmailBox"
                     Width="300"
                     Margin="0 0 0 10"/>

			<!-- Общие параметры -->
			<TextBlock Text="Лимит запросов от пользователя (в минуту)"/>
			<TextBox x:Name="RequestLimitBox"
                     Width="100"
                     Margin="0 0 0 10"/>

			<TextBlock Text="Время жизни кеша (часы)"/>
			<TextBox x:Name="CacheHoursBox"
                     Width="100"
                     Margin="0 0 0 10"/>

			<StackPanel Orientation="Horizontal" Margin="0 0 0 10">
				<CheckBox x:Name="AutoModerationCheck" Content="Автоматическая модерация"/>
			</StackPanel>

			<!-- Безопасность -->
			<TextBlock Text="Безопасность" FontWeight="Bold" Margin="0 10 0 5"/>

			<StackPanel Orientation="Horizontal" Margin="0 0 0 10">
				<CheckBox x:Name="TwoFaCheck" Content="Двухфакторная аутентификация"/>
			</StackPanel>

			<TextBlock Text="Политика паролей"/>
			<TextBox x:Name="PasswordPolicyBox"
                     Width="300"
                     Margin="0 0 0 20"/>

			<Button Content="Сохранить"
                    Width="120"
                    Click="SaveSettings_Click"/>
		</StackPanel>
	</ScrollViewer>
</Page>