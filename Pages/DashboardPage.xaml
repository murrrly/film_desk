<Page x:Class="MovieApp_Adminpanel.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard">

	<StackPanel Margin="20">
		<WrapPanel HorizontalAlignment="Left" Margin="0,0,0,20">
			<Border Background="DarkRed" Width="200" Height="100" Margin="5" Padding="10">
				<StackPanel>
					<TextBlock Text="Новые пользователи сегодня" FontWeight="Bold"/>
					<TextBlock x:Name="NewUsersCount" Text="0" FontSize="24"/>
				</StackPanel>
			</Border>
			<Border Background="DarkRed" Width="200" Height="100" Margin="5" Padding="10">
				<StackPanel>
					<TextBlock Text="Очередь модерации" FontWeight="Bold"/>
					<TextBlock x:Name="PendingReviewsCount" Text="0" FontSize="24"/>
				</StackPanel>
			</Border>
			<Border Background="DarkRed" Width="200" Height="100" Margin="5" Padding="10">
				<StackPanel>
					<TextBlock Text="Статус TMDB" FontWeight="Bold"/>
					<TextBlock x:Name="TmdbStatus" Text="OK" FontSize="24"/>
				</StackPanel>
			</Border>
			<Border Background="DarkRed" Width="200" Height="100" Margin="5" Padding="10">
				<StackPanel>
					<TextBlock Text="Кэш" FontWeight="Bold"/>
					<TextBlock x:Name="CacheHitRate" Text="0%" FontSize="24"/>
				</StackPanel>
			</Border>
		</WrapPanel>

		<GroupBox Header="Последние события" Margin="0,0,0,10">
			<ListBox x:Name="RecentEventsList" Height="200"/>
		</GroupBox>

		<WrapPanel Margin="0,0,0,10">
			<Button Content="Перейти к модерации" Width="180" Margin="5" Click="GoToModeration_Click"/>
			<Button Content="Обновить кеш популярных фильмов" Width="220" Margin="5" Click="RefreshCache_Click"/>
			<Button Content="Посмотреть логи ошибок" Width="180" Margin="5" Click="GoToMonitoring_Click"/>
		</WrapPanel>
	</StackPanel>
</Page>