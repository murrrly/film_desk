<Page x:Class="MovieApp_Adminpanel.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard">


	<StackPanel Margin="20">
		<WrapPanel HorizontalAlignment="Left" Margin="0,0,0,20">
			<Border Background="{StaticResource White}" 
            Width="220" Height="110" 
            Margin="8" Padding="15" 
            CornerRadius="12"
            Effect="{StaticResource DropShadowEffect}">
				<StackPanel VerticalAlignment="Center">
					<TextBlock Text="Новые пользователи" 
                       Foreground="{StaticResource Gray}" 
                       FontSize="12" 
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>
					<Grid>
						<TextBlock x:Name="NewUsersCount" 
                           Text="124" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource DarkBlack}"/>
						<Border Background="{StaticResource PrimaryRed}" 
                        HorizontalAlignment="Left" 
                        Width="3" Height="20" 
                        Margin="-15,0,0,0" 
                        CornerRadius="2"/>
					</Grid>
				</StackPanel>
			</Border>

			<Border Background="{StaticResource White}" 
            Width="220" Height="110" 
            Margin="8" Padding="15" 
            CornerRadius="12"
            Effect="{StaticResource DropShadowEffect}">
				<StackPanel VerticalAlignment="Center">
					<TextBlock Text="Очередь модерации" 
                       Foreground="{StaticResource Gray}" 
                       FontSize="12" 
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>
					<TextBlock x:Name="PendingReviewsCount" 
                       Text="12" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="{StaticResource PrimaryRed}"/>
				</StackPanel>
			</Border>

			<Border Background="{StaticResource White}" 
            Width="220" Height="110" 
            Margin="8" Padding="15" 
            CornerRadius="12"
            Effect="{StaticResource DropShadowEffect}">
				<StackPanel VerticalAlignment="Center">
					<TextBlock Text="Статус TMDB" 
                       Foreground="{StaticResource Gray}" 
                       FontSize="12" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,5"/>
					<StackPanel Orientation="Horizontal">
						<Ellipse Width="10" Height="10" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBlock x:Name="TmdbStatus" 
                           Text="ОНЛАЙН" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource DarkBlack}"
                           VerticalAlignment="Center"/>
					</StackPanel>
				</StackPanel>
			</Border>

			<Border Background="{StaticResource White}" 
            Width="220" Height="110" 
            Margin="8" Padding="15" 
            CornerRadius="12"
            Effect="{StaticResource DropShadowEffect}">
				<StackPanel VerticalAlignment="Center">
					<TextBlock Text="Эффективность кэша" 
                       Foreground="{StaticResource Gray}" 
                       FontSize="12" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,5"/>
					<TextBlock x:Name="CacheHitRate" 
                       Text="98.2%" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="{StaticResource DarkBlack}"/>
				</StackPanel>
			</Border>
		</WrapPanel>

		<GroupBox Header="Последние события" Margin="0,0,0,10">
			<ListBox x:Name="RecentEventsList" Height="200"/>
		</GroupBox>

		<WrapPanel Margin="0,0,0,10">
			<Button Content="Перейти к модерации" Width="180" Margin="5" Click="GoToModeration_Click"/>
			<Button Content="Обновить кеш популярных фильмов" Width="220" Margin="5" Click="RefreshCache_Click"/>
			<Button Content="Посмотреть логи ошибок" Width="180" Margin="5" Click="GoToMonitoring_Click"/>

			<Button Content="Выйти из приложения"
                Width="200"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="5"
                Background="#FF4C4C"
                Foreground="White"
                FontWeight="Bold"
                Click="ExitButton_Click"/>
		</WrapPanel>
	</StackPanel>
</Page>