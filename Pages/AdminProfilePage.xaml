<Page x:Class="MovieApp_Adminpanel.Pages.AdminProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Профиль администратора">

	<StackPanel Margin="20">
		<GroupBox Header="Смена пароля" Margin="0,0,0,10">
			<StackPanel Margin="10">
				<PasswordBox x:Name="CurrentPasswordBox" Margin="0,0,0,5"/>
				<PasswordBox x:Name="NewPasswordBox"  Margin="0,0,0,5"/>
				<PasswordBox x:Name="ConfirmPasswordBox"  Margin="0,0,0,5"/>
				<Button Content="Сменить пароль" Width="150" Click="ChangePassword_Click"/>
			</StackPanel>
		</GroupBox>

		<GroupBox Header="Двухфакторная аутентификация" Margin="0,0,0,10">
			<StackPanel Margin="10">
				<CheckBox x:Name="Enable2FA" Content="Включить 2FA" Margin="0,5"/>
			</StackPanel>
		</GroupBox>

		<GroupBox Header="Журнал аудита (7 дней)" Margin="0,0,0,10">
			<DataGrid x:Name="AuditLogGrid" AutoGenerateColumns="False" Height="200">
				<DataGrid.Columns>
					<DataGridTextColumn Header="Время" Binding="{Binding CreatedAt}" Width="150"/>
					<DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="*"/>
				</DataGrid.Columns>
			</DataGrid>
		</GroupBox>

		<Button Content="Выйти" Width="150" Click="Logout_Click"/>
	</StackPanel>
</Page>