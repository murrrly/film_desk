<Page x:Class="MovieApp_Adminpanel.Pages.AdminProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Профиль администратора">

	<StackPanel Margin="20">
		<TextBlock Text="Профиль администратора" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

		<TextBlock Text="Имя пользователя"/>
		<TextBlock x:Name="UsernameText" Margin="0,0,0,10"/>

		<TextBlock Text="Email"/>
		<TextBox x:Name="EmailBox" Margin="0,0,0,10" IsReadOnly="True"/>

		<TextBlock Text="Роль"/>
		<TextBlock x:Name="RoleText" Margin="0,0,0,20"/>

		<TextBlock Text="Новый пароль"/>
		<PasswordBox x:Name="PasswordBox" Width="250" Margin="0,0,0,20"/>

		<Button Content="Сохранить" Width="120" Click="Save_Click"/>
	</StackPanel>
</Page>