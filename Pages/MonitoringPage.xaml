<Page x:Class="MovieApp_Adminpanel.Pages.MonitoringPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мониторинг и логи">

	<StackPanel Margin="20">
		<GroupBox Header="Фильтры" Margin="0,0,0,10">
			<StackPanel Orientation="Horizontal" Margin="10">
				<TextBlock Text="Дата с:" VerticalAlignment="Center"/>
				<DatePicker x:Name="DateFromPicker" Margin="5,0"/>
				<TextBlock Text="по:" VerticalAlignment="Center" Margin="10,0,0,0"/>
				<DatePicker x:Name="DateToPicker" Margin="5,0"/>
				<TextBlock Text="Тип:" VerticalAlignment="Center" Margin="10,0,0,0"/>
				<ComboBox x:Name="LogTypeCombo" Width="150">
					<ComboBoxItem Content="Все"/>
					<ComboBoxItem Content="TMDB"/>
					<ComboBoxItem Content="Админы"/>
					<ComboBoxItem Content="Системные"/>
				</ComboBox>
				<Button Content="Применить" Margin="10,0" Click="ApplyFilter_Click"/>
			</StackPanel>
		</GroupBox>

		<DataGrid x:Name="LogsGrid" AutoGenerateColumns="False" Height="500">
			<DataGrid.Columns>
				<DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt}" Width="150"/>
				<DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="100"/>
				<DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*"/>
			</DataGrid.Columns>
		</DataGrid>

		<Button Content="Очистить старые логи" Width="200" Margin="0,10,0,0" Click="ClearOldLogs_Click"/>
	</StackPanel>
</Page>