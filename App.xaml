<Application x:Class="MovieApp_Adminpanel.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="LoginWindow.xaml">

	<Application.Resources>

		<!-- ========= ЦВЕТА ========= -->
		<Color x:Key="PrimaryRed">#FF0000</Color>
		<Color x:Key="LightRed">#FFCCCC</Color>
		<Color x:Key="BlackMain">#000000</Color>
		<Color x:Key="DarkBlack">#0F0F0F</Color>
		<Color x:Key="MediumBlack">#333333</Color>
		<Color x:Key="Gray">#999999</Color>
		<Color x:Key="LightGray">#FCFCFD</Color>
		<Color x:Key="White">#FFFFFF</Color>

		<!-- ========= BRUSHES ========= -->
		<SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryRed}"/>
		<SolidColorBrush x:Key="LightRedBrush" Color="{StaticResource LightRed}"/>
		<SolidColorBrush x:Key="TextBrush" Color="{StaticResource MediumBlack}"/>
		<SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource LightGray}"/>
		<SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
		<SolidColorBrush x:Key="GrayBrush" Color="{StaticResource Gray}"/>

		<!-- ========= WINDOW ========= -->
		<Style TargetType="Window">
			<Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
			<Setter Property="FontFamily" Value="Segoe UI"/>
		</Style>

		<!-- ========= TEXT ========= -->
		<Style TargetType="TextBlock">
			<Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
		</Style>

		<!-- ========= INPUT ========= -->
		<Style TargetType="TextBox">
			<Setter Property="Height" Value="38"/>
			<Setter Property="Padding" Value="8"/>
			<Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
			<Setter Property="BorderBrush" Value="{StaticResource GrayBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Margin" Value="0,5,0,15"/>
		</Style>

		<Style TargetType="PasswordBox">
			<Setter Property="Height" Value="38"/>
			<Setter Property="Padding" Value="8"/>
			<Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
			<Setter Property="BorderBrush" Value="{StaticResource GrayBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Margin" Value="0,5,0,20"/>
		</Style>

		<!-- ========= BUTTON ========= -->
		<Style TargetType="Button">
			<Setter Property="Height" Value="40"/>
			<Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

	</Application.Resources>
</Application>