<Window x:Class="MovieApp_Adminpanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Panel - Movie App" Height="900" Width="1000"
        WindowStartupLocation="CenterScreen">

   

    <Grid>
        <!-- Header -->
        <Border Background="#34495e" Padding="15" Height="70" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🎬 Админ-панель" 
                          Foreground="White" FontSize="18" FontWeight="Bold"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Администратор" Foreground="#ecf0f1" 
                              VerticalAlignment="Center" Margin="0 0 15 0"/>
                    <Button Content="🚪 Выйти" 
                            Background="#e74c3c" Padding="10,5" Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl Margin="0 68 0 0" Padding="5" Background="White" BorderThickness="0">

            <!-- Database Settings -->
            <TabItem Header="🗄️ Настройки БД">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" Width="600">
                        <TextBlock Text="Настройки подключения к базе данных" 
                                  FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                        <TextBlock Text="Сервер:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="ServerTextBox"  
                                Text="localhost"/>

                        <TextBlock Text="Порт:" FontWeight="SemiBold" Margin="0,15,0,5"/>
                        <TextBox x:Name="PortTextBox"  
                                Text="5432"/>

                        <TextBlock Text="Имя базы данных:" FontWeight="SemiBold" Margin="0,15,0,5"/>
                        <TextBox x:Name="DatabaseTextBox"  
                                Text="movie_library"/>

                        <TextBlock Text="Пользователь:" FontWeight="SemiBold" Margin="0,15,0,5"/>
                        <TextBox x:Name="UserTextBox"  
                                Text="postgres"/>

                        <TextBlock Text="Пароль:" FontWeight="SemiBold" Margin="0,15,0,5"/>
                        <PasswordBox x:Name="DbPasswordBox"/>

                        <StackPanel Orientation="Horizontal" Margin="0,25,0,0">
                            <Button Content="💾 Сохранить настройки" 
                                    Background="#27ae60" Click="SaveDbSettings_Click"/>
                            <Button Content="🔄 Тестировать подключение" 
                                    Background="#3498db" Margin="10,0,0,0"
                                    Click="TestDbConnection_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- User Management -->
            <TabItem Header="👥 Управление пользователями">
                <StackPanel Margin="20">
                    <TextBlock Text="Управление пользователями системы" 
                              FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                    <!-- User Statistics -->
                    <WrapPanel Margin="0,0,0,20">
                        <Border BorderBrush="#bdc3c7" BorderThickness="1" 
                               Margin="0,0,15,15" Padding="15" Background="#f8f9fa">
                            <StackPanel>
                                <TextBlock Text="Всего пользователей" 
                                          Foreground="#7f8c8d" FontSize="12"/>
                                <TextBlock Text="1,247" FontSize="24" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#bdc3c7" BorderThickness="1" 
                               Margin="0,0,15,15" Padding="15" Background="#f8f9fa">
                            <StackPanel>
                                <TextBlock Text="Активных сегодня" 
                                          Foreground="#7f8c8d" FontSize="12"/>
                                <TextBlock Text="156" FontSize="24" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#bdc3c7" BorderThickness="1" 
                               Margin="0,0,15,15" Padding="15" Background="#f8f9fa">
                            <StackPanel>
                                <TextBlock Text="Администраторов" 
                                          Foreground="#7f8c8d" FontSize="12"/>
                                <TextBlock Text="3" FontSize="24" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Users Grid -->
                    <DataGrid x:Name="UsersDataGrid" Height="300" AutoGenerateColumns="False"
                             IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Width="50" Binding="{Binding Id}"/>
                            <DataGridTextColumn Header="Имя" Width="150" Binding="{Binding Username}"/>
                            <DataGridTextColumn Header="Email" Width="200" Binding="{Binding Email}"/>
                            <DataGridTextColumn Header="Роль" Width="100" Binding="{Binding Role}"/>
                            <DataGridTextColumn Header="Дата регистрации" Width="120" 
                                               Binding="{Binding CreatedAt}"/>
                            <DataGridTemplateColumn Header="Действия" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Редактировать" 
                                                 
                                                Background="#3498db" Padding="5,2" FontSize="12"
                                                Click="EditUser_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Add User Button -->
                    <Button Content="➕ Добавить пользователя" 
                            Background="#27ae60" Margin="0,15,0,0" HorizontalAlignment="Left"
                            Click="AddUser_Click"/>
                </StackPanel>
            </TabItem>

            <!-- Reviews & Ratings Management -->
            <TabItem Header="⭐ Управление отзывами">
                <StackPanel Margin="20">
                    <TextBlock Text="Модерация отзывов и оценок" 
                              FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                    <!-- Reviews Statistics -->
                    <WrapPanel Margin="0,0,0,20">
                        <Border BorderBrush="#bdc3c7" BorderThickness="1" 
                               Margin="0,0,15,15" Padding="15" Background="#f8f9fa">
                            <StackPanel>
                                <TextBlock Text="Всего отзывов" 
                                          Foreground="#7f8c8d" FontSize="12"/>
                                <TextBlock Text="8,542" FontSize="24" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#bdc3c7" BorderThickness="1" 
                               Margin="0,0,15,15" Padding="15" Background="#f8f9fa">
                            <StackPanel>
                                <TextBlock Text="На модерации" 
                                          Foreground="#7f8c8d" FontSize="12"/>
                                <TextBlock Text="23" FontSize="24" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#bdc3c7" BorderThickness="1" 
                               Margin="0,0,15,15" Padding="15" Background="#f8f9fa">
                            <StackPanel>
                                <TextBlock Text="Средняя оценка" 
                                          Foreground="#7f8c8d" FontSize="12"/>
                                <TextBlock Text="7.8" FontSize="24" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Reviews for Moderation -->
                    <Border BorderBrush="#bdc3c7" BorderThickness="1" Padding="15" 
                           Background="#f8f9fa" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Отзывы на модерации" 
                                      FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <DataGrid x:Name="ReviewsDataGrid" Height="200" 
                                     AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Width="50" Binding="{Binding Id}"/>
                                    <DataGridTextColumn Header="Фильм" Width="150" Binding="{Binding MovieTitle}"/>
                                    <DataGridTextColumn Header="Пользователь" Width="120" Binding="{Binding User}"/>
                                    <DataGridTextColumn Header="Оценка" Width="60" Binding="{Binding Rating}"/>
                                    <DataGridTextColumn Header="Дата" Width="100" Binding="{Binding Date}"/>
                                    <DataGridTextColumn Header="Статус" Width="80" Binding="{Binding Status}"/>
                                    <DataGridTemplateColumn Header="Действия" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="👁️ Просмотр" 
                                                             
                                                            Background="#3498db" Padding="5,2" FontSize="10"
                                                            Click="ViewReview_Click"/>
                                                    <Button Content="✅ Одобрить" Padding="5,2" FontSize="10" Margin="5,0,0,0"
                                                            Click="ApproveReview_Click"/>
                                                    <Button Content="❌ Отклонить" 
                                                             
                                                            Background="#e74c3c" Padding="5,2" FontSize="10" Margin="5,0,0,0"
                                                            Click="RejectReview_Click"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- User Lists Management -->
                    <Border BorderBrush="#bdc3c7" BorderThickness="1" Padding="15" 
                           Background="#f8f9fa">
                        <StackPanel>
                            <TextBlock Text="Управление пользовательскими списками" 
                                      FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox x:Name="SearchUserTextBox" Width="200" 
                                         
                                        Text="Поиск пользователя..."/>
                                <Button Content="🔍 Найти" 
                                         
                                        Background="#3498db" Margin="10,0,0,0"
                                        Click="SearchUser_Click"/>
                            </StackPanel>

                            <DataGrid x:Name="UserListsDataGrid" Height="150" 
                                     AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Пользователь" Width="120" Binding="{Binding Username}"/>
                                    <DataGridTextColumn Header="Тип списка" Width="100" Binding="{Binding ListType}"/>
                                    <DataGridTextColumn Header="Название" Width="150" Binding="{Binding ListName}"/>
                                    <DataGridTextColumn Header="Кол-во фильмов" Width="80" Binding="{Binding MovieCount}"/>
                                    <DataGridTextColumn Header="Создан" Width="100" Binding="{Binding CreatedAt}"/>
                                    <DataGridTemplateColumn Header="Действия" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="📋 Просмотр" 
                                                         
                                                        Background="#9b59b6" Padding="5,2" FontSize="10"
                                                        Click="ViewUserList_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- Analytics & Reports -->
            <TabItem Header="📊 Аналитика и отчеты">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Аналитика использования системы" 
                                  FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                        <!-- Key Metrics -->
                        <WrapPanel Margin="0,0,0,20">
                            <Border BorderBrush="#bdc3c7" BorderThickness="1" 
                                   Margin="0,0,15,15" Padding="15" Background="#f8f9fa">
                                <StackPanel>
                                    <TextBlock Text="Новых пользователей" 
                                              Foreground="#7f8c8d" FontSize="12"/>
                                    <TextBlock Text="45" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#bdc3c7" BorderThickness="1" 
                                   Margin="0,0,15,15" Padding="15" Background="#f8f9fa">
                                <StackPanel>
                                    <TextBlock Text="Новых отзывов" 
                                              Foreground="#7f8c8d" FontSize="12"/>
                                    <TextBlock Text="127" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#bdc3c7" BorderThickness="1" 
                                   Margin="0,0,15,15" Padding="15" Background="#f8f9fa">
                                <StackPanel>
                                    <TextBlock Text="Создано списков" 
                                              Foreground="#7f8c8d" FontSize="12"/>
                                    <TextBlock Text="89" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#bdc3c7" BorderThickness="1" 
                                   Margin="0,0,15,15" Padding="15" Background="#f8f9fa">
                                <StackPanel>
                                    <TextBlock Text="Активных сессий" 
                                              Foreground="#7f8c8d" FontSize="12"/>
                                    <TextBlock Text="234" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- Report Generation -->
                        <Border BorderBrush="#bdc3c7" BorderThickness="1" Padding="15" 
                               Background="#f8f9fa">
                            <StackPanel>
                                <TextBlock Text="Генерация отчетов" FontWeight="SemiBold" 
                                          Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <ComboBox x:Name="ReportTypeComboBox" Width="150" SelectedIndex="0">
                                        <ComboBoxItem Content="Ежедневный отчет"/>
                                        <ComboBoxItem Content="Недельный отчет"/>
                                        <ComboBoxItem Content="Месячный отчет"/>
                                    </ComboBox>

                                    <ComboBox x:Name="ReportFormatComboBox" Width="150" Margin="10,0,0,0" SelectedIndex="0">
                                        <ComboBoxItem Content="JSON"/>
                                        <ComboBoxItem Content="CSV"/>
                                        <ComboBoxItem Content="PDF"/>
                                    </ComboBox>
                                </StackPanel>

                                <Button Content="📥 Сгенерировать отчет" 
                                        Background="#9b59b6" HorizontalAlignment="Left"
                                        Click="GenerateReport_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>