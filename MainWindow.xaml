<Window x:Class="MovieApp_Adminpanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movie Library Admin" Height="800" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="White">

	<!-- Здесь только один блок ресурсов -->
	<Window.Resources>
		<Style TargetType="MenuItem" x:Key="TopMenuItemStyle">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Padding" Value="30,12"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="MenuItem">
						<Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Border" Property="Background" Value="#3A3A3A"/>
							</Trigger>
							<Trigger Property="Tag" Value="Active">
								<Setter TargetName="Border" Property="Background" Value="#007ACC"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<DockPanel>
		<!-- Верхнее меню -->
		<Menu DockPanel.Dock="Top" Background="#2D2D30" Height="40">
			<Menu.Resources>
				<Style TargetType="MenuItem">
					<Setter Property="Background" Value="Transparent"/>
					<Setter Property="FontSize" Value="14"/>
					<Setter Property="FontWeight" Value="Bold"/>
					<Setter Property="Padding" Value="20,10"/>
					<Setter Property="Cursor" Value="Hand"/>
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="MenuItem">
								<Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
									<!-- Используем TextBlock для текста -->
									<TextBlock Text="{TemplateBinding Header}" 
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="Border" Property="Background" Value="#3A3A3A"/>
									</Trigger>
									<Trigger Property="Tag" Value="Active">
										<Setter TargetName="Border" Property="Background" Value="#007ACC"/>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</Menu.Resources>

			<MenuItem Header="Главная" Click="Dashboard_Click" x:Name="MenuDashboard"/>
			<MenuItem Header="Пользователи" Click="Users_Click" x:Name="MenuUsers"/>
			<MenuItem Header="Модерация" Click="Moderation_Click" x:Name="MenuModeration"/>
			<MenuItem Header="Мониторинг" Click="Monitoring_Click" x:Name="MenuMonitoring"/>
			<MenuItem Header="Аналитика" Click="Analytics_Click" x:Name="MenuAnalytics"/>
			<MenuItem Header="Настройки" Click="Settings_Click" x:Name="MenuSettings"/>
			<MenuItem Header="Профиль" Click="AdminProfile_Click" x:Name="MenuProfile"/>
		</Menu>

		<!-- Заголовок текущей страницы -->
		<TextBlock x:Name="PageTitle"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="20,10,0,10"
                   DockPanel.Dock="Top"
                   Text="Главная"/>

		<!-- Основной контент -->
		<Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
	</DockPanel>
</Window>