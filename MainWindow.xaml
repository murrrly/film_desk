<Window x:Class="MovieApp_Adminpanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movie Library Admin" Height="800" Width="900"
        WindowStartupLocation="CenterScreen">
	<DockPanel>
		<!-- Меню сверху -->
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="Главная" Click="Dashboard_Click"/>
			<MenuItem Header="Пользователи" Click="Users_Click"/>
			<MenuItem Header="Модерация" Click="Moderation_Click"/>
			<MenuItem Header="Мониторинг" Click="Monitoring_Click"/>
			<MenuItem Header="Аналитика" Click="Analytics_Click"/>
			<MenuItem Header="Настройки" Click="Settings_Click"/>
			<MenuItem Header="Профиль" Click="AdminProfile_Click"/>
		</Menu>

		<!-- Основной контент -->
		<Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
	</DockPanel>
</Window>